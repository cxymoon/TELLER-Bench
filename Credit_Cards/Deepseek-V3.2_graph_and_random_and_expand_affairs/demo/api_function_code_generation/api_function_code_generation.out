        bankruptcy_flag=bureau_result['bankruptcy_flag'],
        fraud_alert_flags=fraud_result['fraud_alert_flags'],
        applicant_annual_income=app['applicant_annual_income']
    )
    print(f"   Final Decision: {decision_result['final_decision']}")
    print(f"   Manual Review Required: {decision_result['manual_review_required']}")
    
