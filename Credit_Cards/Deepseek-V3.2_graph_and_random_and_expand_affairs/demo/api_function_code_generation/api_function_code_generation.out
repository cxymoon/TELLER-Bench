# ============================================================================
# HELPER FUNCTION FOR PROCESSING TOOL CALLS
# ============================================================================

def process_tool_call(tool_name: str, tool_input: Dict[str, Any]) -> Dict[str, Any]:
    """
    Process a tool call by routing to the appropriate API function
    
    Args:
        tool_name: Name of the tool/API to call
        tool_input: Dictionary of input parameters
        
    Returns:
        Dictionary containing the API result
    """
    tool_map = {
        "ValidateApplicationData": ValidateApplicationData,
        "VerifyIdentity": VerifyIdentity,
        "ScreenSanctionsWatchlist": ScreenSanctionsWatchlist,
        "DetectFraudIndicators": DetectFraudIndicators,
        "RetrieveCreditBureauData": RetrieveCreditBureauData,
        "CalculateDebtToIncomeRatio": CalculateDebtToIncomeRatio,
        "EvaluateCreditScorecard": EvaluateCreditScorecard,
        "DetermineCreditDecision": DetermineCreditDecision,
        "AssignCreditTerms": AssignCreditTerms,
        "GenerateAdverseActionNotice": GenerateAdverseActionNotice,
        "FinalizeApplicationOutputs": FinalizeApplicationOutputs
    }
    
    if tool_name not in tool_map:
        return {"error": f"Unknown tool: {tool_name}"}
    
    try:
        result = tool_map[tool_name](**tool_input)
        return result
    except Exception as e:
        return {"error": f"Tool execution failed: {str(e)}"}


