        print(f"   Assigned APR: {terms_result['assigned_apr']:.2%}")
        
        # Step 10: Generate Adverse Action (not needed for approval with favorable terms)
        print("\n10. GenerateAdverseActionNotice")
        adverse_result = GenerateAdverseActionNotice(
