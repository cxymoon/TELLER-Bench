        )
        print(f"   Adverse Action Generated: {adverse_result['adverse_action_letter_generated']}")
        
        # Step 11: Finalize Outputs
        print("\n11. FinalizeApplicationOutputs")
        final_result = FinalizeApplicationOutputs(
            application_id=app['application_id'],
            processing_start_timestamp=app['processing_start_timestamp'],
