            fraud_alert_flags=fraud_result['fraud_alert_flags'],
            uploaded_documents=app.get('uploaded_documents', []),
            approved_credit_limit=terms_result['approved_credit_limit'],
            assigned_apr=terms_result['assigned_apr'],
            underwriter_id=app.get('underwriter_id'),
            deposit_verification_status=app.get('deposit_verification_status')
        )
        print(f"   Turnaround Time: {final_result['turnaround_time_seconds']} seconds")
        print(f"   Auto Decision: {final_result['auto_decision_flag']}")
        print(f"   Account Activation Eligible: {final_result['account_activation_eligible']}")
        print(f"   Estimated Delivery Date: {final_result['estimated_card_delivery_date']}")
    
    print("\n" + "=" * 80)
