<class>
class Tool_ValidateApplicationData(BaseModel):
    application_id: str = Field(..., description="Unique application identifier")
    business_type: str = Field(..., description="Retail/Business/Secured classification")

class Tool_VerifyIdentity(BaseModel):
    application_id: str = Field(..., description="Unique application identifier")
    applicant_id: str = Field(..., description="Customer identity number")

class Tool_ScreenSanctionsWatchlist(BaseModel):
    application_id: str = Field(..., description="Unique application identifier")
    identity_verification_method: str = Field(..., description="Output from VerifyIdentity")

class Tool_DetectFraudIndicators(BaseModel):
    watchlist_check_result: str = Field(..., description="Output from ScreenSanctionsWatchlist")

class Tool_RetrieveCreditBureauData(BaseModel):
    fraud_risk_level: str = Field(..., description="Output from DetectFraudIndicators")

class Tool_CalculateDebtToIncomeRatio(BaseModel):
    total_outstanding_debt: float = Field(..., description="Output from RetrieveCreditBureauData")

class Tool_EvaluateCreditScorecard(BaseModel):
    credit_score: int = Field(..., description="Output from RetrieveCreditBureauData")
    debt_to_income_ratio: float = Field(..., description="Output from CalculateDebtToIncomeRatio")

class Tool_DetermineCreditDecision(BaseModel):
    internal_risk_score: int = Field(..., description="Output from EvaluateCreditScorecard")
    watchlist_check_result: str = Field(..., description="Output from ScreenSanctionsWatchlist")

class Tool_AssignCreditTerms(BaseModel):
    final_decision: str = Field(..., description="Output from DetermineCreditDecision")
    internal_risk_score: int = Field(..., description="Output from EvaluateCreditScorecard")

class Tool_GenerateAdverseActionNotice(BaseModel):
    final_decision: str = Field(..., description="Output from DetermineCreditDecision")
    credit_bureau_source: str = Field(..., description="Output from RetrieveCreditBureauData")

class Tool_FinalizeApplicationOutputs(BaseModel):
    approved_credit_limit: float = Field(None, description="Output from AssignCreditTerms")
    adverse_action_letter_generated: bool = Field(..., description="System state flag")

class Tool_get_application_by_id(BaseModel):
    application_id: str = Field(..., description="Unique application identifier")

class Tool_update_application_data(BaseModel):
    application_id: str = Field(..., description="Unique application identifier")
    updates: Dict[str, Any] = Field(..., description="Key-value pairs to update")
</class>

