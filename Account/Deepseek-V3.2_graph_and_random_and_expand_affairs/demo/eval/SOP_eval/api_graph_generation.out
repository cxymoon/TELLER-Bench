### Class Encapsulation
<class>
class Tool_DocumentImageResolutionValidation(BaseModel):
    application_id: str = Field(..., description="Unique application identifier")
    submitted_documents: List[str] = Field(..., description="List of document image URLs")

class Tool_ValidateApplicationData(BaseModel):
    application_id: str = Field(..., description="Unique application identifier")
    id_ocr_extracted_data: Dict[str, Any] = Field(..., description="OCR-extracted data from identity documents")

class Tool_ExecuteCIPVerification(BaseModel):
    data_consistency_score: float = Field(..., description="Data quality score from validation")

class Tool_ScreenWatchlists(BaseModel):
    cip_verification_status: str = Field(..., description="Verification status from CIP process")

class Tool_AssessRiskProfile(BaseModel):
    cip_verification_status: str = Field(..., description="Verification status from CIP process")
    facial_match_confidence_score: float = Field(..., description="Biometric matching confidence score")

class Tool_ExecuteAutoDecision(BaseModel):
    watchlist_screening_result: str = Field(..., description="Result from watchlist screening")
    fraud_risk_score: float = Field(..., description="Computed fraud risk metric")
    chexsystems_score: float = Field(..., description="Credit history score")

class Tool_ProcessManualReview(BaseModel):
    auto_decision_result: str = Field(..., description="Output from automated decisioning")
    fraud_risk_score: float = Field(..., description="Computed fraud risk metric")

class Tool_CreateBankAccount(BaseModel):
    final_approval_status: str = Field(..., description="Final approval status from decisioning")

class Tool_ProcessAccountFunding(BaseModel):
    account_number_generated: str = Field(..., description="Newly created account number")

class Tool_ProvisionAncillaryProducts(BaseModel):
    account_number_generated: str = Field(..., description="Newly created account number")

class Tool_CalculateProcessMetrics(BaseModel):
    application_start_timestamp: str = Field(..., description="Initial application submission time")
    account_creation_timestamp: str = Field(..., description="Time of account creation")
    final_approval_status: str = Field(..., description="Final application decision status")
</class>

