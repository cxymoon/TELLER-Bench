      - name: "funds_availability_verified"
        data_type: "boolean"
        source: "other_api"
        required: true
    output_parameters:
      - name: "pre_trade_compliance_passed"
        data_type: "boolean"
        destination: "other_api"
    direct_dependencies:
      - dependent_api: "ValidateProductSuitability"
        dependency_type: "data_dependency"
        dependency_reason: "Requires suitability_check_passed output from ValidateProductSuitability as key input to compliance aggregation logic"
      - dependent_api: "ExecuteAMLSanctionsScreening"
        dependency_type: "data_dependency"
        dependency_reason: "Requires aml_sanctions_screening_status from ExecuteAMLSanctionsScreening to verify no sanctions violations exist"
      - dependent_api: "ValidateThresholdAndSOW"
        dependency_type: "data_dependency"
        dependency_reason: "Requires transaction_threshold_exceeded from ValidateThresholdAndSOW to apply conditional SOW validation logic"
      - dependent_api: "VerifyFundsAvailability"
        dependency_type: "data_dependency"
        dependency_reason: "Requires funds_availability_verified from VerifyFundsAvailability to confirm transaction can be financially settled"
    complexity_level: "high"
    business_criticality: "high"

  - api_name: "CalculateTransactionFinancials"
    description: "Computes all transaction financial metrics including front_end_load_amount (subscription_amount × front_end_load_percentage / 100), net_investment_amount (subscription_amount - front_end_load_amount), estimated_units (net_investment_amount / current_nav for mutual funds), and annual_management_fee_amount (net_investment_amount × annual_management_fee_percentage / 100) with precision to regulatory standards"
    purpose: "Transparent fee disclosure calculation providing clients with complete understanding of all costs and actual invested capital before final authorization"
    input_parameters:
      - name: "subscription_amount"
        data_type: "float"
        source: "other_api"
        required: true
      - name: "front_end_load_percentage"
        data_type: "float"
        source: "other_api"
        required: true
      - name: "annual_management_fee_percentage"
        data_type: "float"
        source: "other_api"
        required: true
      - name: "current_nav"
        data_type: "float"
        source: "other_api"
        required: true
      - name: "product_category"
        data_type: "enum"
        source: "other_api"
        required: true
      - name: "pre_trade_compliance_passed"
        data_type: "boolean"
        source: "other_api"
        required: true
    output_parameters:
      - name: "front_end_load_amount"
        data_type: "float"
        destination: "storage"
      - name: "net_investment_amount"
        data_type: "float"
        destination: "other_api"
      - name: "estimated_units"
        data_type: "float"
        destination: "storage"
      - name: "annual_management_fee_amount"
        data_type: "float"
        destination: "storage"
    direct_dependencies:
      - dependent_api: "CreateInvestmentOrder"
        dependency_type: "data_dependency"
        dependency_reason: "Requires subscription_amount, front_end_load_percentage, annual_management_fee_percentage, current_nav, and product_category from CreateInvestmentOrder for financial calculations"
      - dependent_api: "AggregateComplianceChecks"
        dependency_type: "state_dependency"
        dependency_reason: "Only executes when pre_trade_compliance_passed = TRUE from AggregateComplianceChecks, ensuring calculations performed only for compliant transactions proceeding to execution"
    complexity_level: "medium"
    business_criticality: "high"

  - api_name: "ManageCoolingOffPeriod"
    description: "Evaluates product_category to determine if cooling_off_period_required applies (TRUE for structured products), calculates cooling-off expiry timestamp by adding cooling_off_period_hours to client_authorization_timestamp, sets transaction_status to Pending_Cooling_Off or Ready_for_Execution based on cooling-off applicability"
    purpose: "Implements regulatory cooling-off period for complex products, giving clients unconditional cancellation rights within specified timeframe before final execution"
    input_parameters:
      - name: "transaction_id"
        data_type: "string"
        source: "other_api"
        required: true
      - name: "product_category"
        data_type: "enum"
        source: "other_api"
        required: true
      - name: "cooling_off_period_required"
        data_type: "boolean"
        source: "system_state"
        required: true
      - name: "cooling_off_period_hours"
        data_type: "integer"
        source: "system_state"
        required: true
      - name: "client_authorization_timestamp"
        data_type: "datetime"
        source: "system_state"
        required: true
    output_parameters:
      - name: "transaction_status"
        data_type: "enum"
        destination: "other_api"
    direct_dependencies:
      - dependent_api: "CalculateTransactionFinancials"
        dependency_type: "state_dependency"
        dependency_reason: "Executes after CalculateTransactionFinancials completes financial calculations, using product_category to determine cooling-off applicability and manage transaction status transition"
    complexity_level: "medium"
    business_criticality: "high"

  - api_name: "ExecuteInvestmentTransaction"
    description: "Routes order to appropriate execution channel (fund house gateway for mutual funds, Treasury desk for structured products) transmitting transaction details, receives preliminary confirmation generating trade_reference_number or contract_note_number, instructs Core Banking System to debit settlement_account_number for subscription_amount, sets transaction_status to Executed, records execution_timestamp, calculates settlement_date based on product settlement cycles"
    purpose: "Final execution step consummating the investment transaction through external order routing and internal settlement account debit, creating binding trade commitment"
    input_parameters:
      - name: "transaction_id"
        data_type: "string"
        source: "other_api"
        required: true
      - name: "product_category"
        data_type: "enum"
        source: "other_api"
        required: true
      - name: "product_code"
        data_type: "string"
        source: "other_api"
        required: true
      - name: "net_investment_amount"
        data_type: "float"
        source: "other_api"
        required: true
      - name: "settlement_account_number"
        data_type: "string"
        source: "other_api"
        required: true
      - name: "client_id"
        data_type: "string"
        source: "other_api"
        required: true
      - name: "transaction_status"
        data_type: "enum"
        source: "other_api"
        required: true
      - name: "subscription_amount"
        data_type: "float"
        source: "other_api"
        required: true
    output_parameters:
      - name: "trade_reference_number"
        data_type: "string"
        destination: "storage"
      - name: "contract_note_number"
        data_type: "string"
        destination: "storage"
      - name: "execution_timestamp"
        data_type: "datetime"
        destination: "other_api"
      - name: "settlement_date"
        data_type: "datetime"
        destination: "storage"
      - name: "transaction_status"
        data_type: "enum"
        destination: "storage"
    direct_dependencies:
      - dependent_api: "ManageCoolingOffPeriod"
        dependency_type: "state_dependency"
        dependency_reason: "Only executes when transaction_status = Ready_for_Execution from ManageCoolingOffPeriod, ensuring cooling-off period has elapsed or is not applicable before final execution"
      - dependent_api: "CalculateTransactionFinancials"
        dependency_type: "data_dependency"
        dependency_reason: "Requires net_investment_amount from CalculateTransactionFinancials for order routing and subscription_amount for settlement account debit"
      - dependent_api: "CreateInvestmentOrder"
        dependency_type: "data_dependency"
        dependency_reason: "Requires transaction_id, product_code, product_category, settlement_account_number, client_id from CreateInvestmentOrder for execution routing and settlement"
    complexity_level: "high"
    business_criticality: "high"

  - api_name: "CalculateSTPFlag"
    description: "Evaluates entire transaction lifecycle to determine if straight-through processing was achieved by checking if any manual intervention, exception handling, workflow rerouting, supervisor override, or compliance escalation occurred, sets straight_through_processing_flag to TRUE only for zero-touch transactions"
    purpose: "Operational efficiency metric calculation identifying fully automated transactions for STP rate KPI reporting and process optimization analysis"
    input_parameters:
      - name: "transaction_id"
        data_type: "string"
        source: "other_api"
        required: true
      - name: "suitability_mismatch_flag"
        data_type: "boolean"
        source: "other_api"
        required: true
      - name: "supervisor_approval_required"
        data_type: "boolean"
        source: "system_state"
        required: true
      - name: "aml_sanctions_screening_status"
        data_type: "enum"
        source: "other_api"
        required: true
    output_parameters:
      - name: "straight_through_processing_flag"
        data_type: "boolean"
        destination: "storage"
    direct_dependencies:
      - dependent_api: "ExecuteInvestmentTransaction"
        dependency_type: "state_dependency"
        dependency_reason: "Executes after ExecuteInvestmentTransaction completes to evaluate entire transaction lifecycle and determine if any manual touchpoints occurred during processing"
    complexity_level: "low"
    business_criticality: "medium"

  - api_name: "ExecutePostTradeComplianceReview"
    description: "Reviews executed transaction against compliance checklist covering documentation completeness (disclosure_documents_presented), audio_video_recording_id content quality for complex products, suitability mismatch waiver documentation, and overall transaction coherence, documents findings in compliance_review_notes, sets compliance_defect_flag if violations identified"
    purpose: "Post-execution quality assurance and regulatory compliance verification to identify miss-selling, documentation deficiencies, or process violations requiring corrective action"
    input_parameters:
      - name: "transaction_id"
        data_type: "string"
        source: "other_api"
        required: true
      - name: "audio_video_recording_id"
        data_type: "string"
        source: "system_state"
        required: false
      - name: "suitability_mismatch_flag"
        data_type: "boolean"
        source: "other_api"
        required: true
      - name: "transaction_threshold_exceeded"
        data_type: "boolean"
        source: "other_api"
        required: true
      - name: "disclosure_documents_presented"
        data_type: "array"
        source: "system_state"
        required: true
    output_parameters:
      - name: "compliance_defect_flag"
        data_type: "boolean"
        destination: "storage"
      - name: "compliance_review_notes"
        data_type: "string"
        destination: "storage"
    direct_dependencies:
      - dependent_api: "ExecuteInvestmentTransaction"
        dependency_type: "state_dependency"
        dependency_reason: "Only executes after ExecuteInvestmentTransaction completes with transaction_status = Executed, enabling post-trade review of completed transaction"
    complexity_level: "medium"
    business_criticality: "high"

  - api_name: "CalculateProcessingMetrics"
    description: "Computes total_processing_time_minutes by calculating elapsed time in minutes between transaction_timestamp (initiation) and execution_timestamp (completion), providing quantitative measure of end-to-end processing efficiency for cycle time analysis and operational performance reporting"
    purpose: "Operational performance metric calculation enabling monitoring of processing efficiency, identification of bottlenecks, and trend analysis for continuous process improvement"
    input_parameters:
      - name: "transaction_timestamp"
        data_type: "datetime"
        source: "system_state"
        required: true
      - name: "execution_timestamp"
        data_type: "datetime"
        source: "other_api"
        required: true
    output_parameters:
      - name: "total_processing_time_minutes"
        data_type: "integer"
        destination: "storage"
    direct_dependencies:
      - dependent_api: "ExecuteInvestmentTransaction"
        dependency_type: "data_dependency"
        dependency_reason: "Requires execution_timestamp from ExecuteInvestmentTransaction to calculate elapsed time from transaction initiation to execution completion"
    complexity_level: "low"
    business_criticality: "low"
```
