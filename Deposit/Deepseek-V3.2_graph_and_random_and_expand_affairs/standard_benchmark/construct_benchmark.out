def parse_entry(entry_list: List[str]) -> Dict[str, Any]:
    """Parse a list of key:value strings into a dictionary"""
    data = {}
    for item in entry_list:
        if ':' in item:
            key, value = item.split(':', 1)
            # Handle empty values
            if value == '' or value == 'None':
                data[key] = None
            # Handle boolean values
            elif value in ['True', 'true']:
                data[key] = True
            elif value in ['False', 'false']:
                data[key] = False
            # Handle numeric values
            elif value.replace('.', '').replace('-', '').isdigit():
                if '.' in value:
                    data[key] = float(value)
                else:
                    data[key] = int(value) if value.isdigit() else value
            # Handle JSON strings
            elif value.startswith('{') or value.startswith('['):
                try:
                    data[key] = json.loads(value.replace("'", '"'))
                except:
                    data[key] = value
            else:
                data[key] = value
    return data

def safe_get(data: Dict, key: str, default: Any = None) -> Any:
    """Safely get a value from dictionary with default"""
    value = data.get(key, default)
    if value is None or value == '' or value == 'None':
        return default
    return value

def safe_float(value: Any, default: float = 0.0) -> float:
    """Safely convert to float"""
    try:
        if value is None or value == '' or value == 'None':
            return default
        return float(value)
    except:
        return default

def safe_int(value: Any, default: int = 0) -> int:
    """Safely convert to int"""
    try:
        if value is None or value == '' or value == 'None':
            return default
        return int(value)
    except:
        return default

def safe_bool(value: Any, default: bool = False) -> bool:
    """Safely convert to bool"""
    if value is None or value == '' or value == 'None':
        return default
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.lower() in ['true', 'yes', '1']
    return bool(value)

def safe_str(value: Any, default: str = '') -> str:
    """Safely convert to string"""
    if value is None or value == 'None':
        return default
    return str(value)

# Process all transactions
for entry_list in sample_data:
    try:
        # Parse the data entry
        data = parse_entry(entry_list)
        transaction_id = safe_str(data.get('transaction_id'))
        
        print(f"\n{'='*80}")
        print(f"Processing: {transaction_id}")
        print(f"{'='*80}")
        
        # Step 1: KYC Verification (Section 5.1)
        kyc_result = KYC_Verification_API(
            transaction_id=transaction_id,
            customer_id=safe_str(data.get('customer_id')),
            customer_name=safe_str(data.get('customer_name')),
            customer_id_type=safe_str(data.get('customer_id_type')),
            customer_id_number=safe_str(data.get('customer_id_number')),
            customer_address=safe_str(data.get('customer_address')),
            customer_tax_id=safe_str(data.get('customer_tax_id')),
            customer_phone=safe_str(data.get('customer_phone')),
            customer_email=safe_str(data.get('customer_email'))
        )
        
        # Step 2: AML Sanctions Screening (Section 5.2)
        aml_result = AML_Sanctions_Screening_API(
            transaction_id=transaction_id,
            customer_id=safe_str(data.get('customer_id')),
            customer_name=safe_str(data.get('customer_name')),
            customer_address=safe_str(data.get('customer_address')),
            customer_tax_id=safe_str(data.get('customer_tax_id')),
            kyc_verification_status=safe_str(data.get('kyc_verification_status', 'VERIFIED')),
            deposit_amount=safe_float(data.get('deposit_amount')),
            deposit_channel=safe_str(data.get('deposit_channel')),
            branch_code=safe_str(data.get('branch_code')),
            funding_source_type=safe_str(data.get('funding_source_type'))
        )
        
        # Step 3: CTR Evaluation (Section 5.3)
        ctr_result = CTR_Evaluation_API(
            transaction_id=transaction_id,
            customer_id=safe_str(data.get('customer_id')),
            deposit_amount=safe_float(data.get('deposit_amount')),
            funding_source_type=safe_str(data.get('funding_source_type')),
            transaction_timestamp=safe_str(data.get('transaction_timestamp')),
            ctr_threshold_amount=safe_float(data.get('ctr_threshold_amount', 10000.0))
        )
        
        # Step 4: Currency Validation (Section 5.4) - only for CASH transactions
        cash_denom = safe_get(data, 'cash_denomination_breakdown', {})
        currency_result = Currency_Validation_API(
            transaction_id=transaction_id,
            funding_source_type=safe_str(data.get('funding_source_type')),
            deposit_amount=safe_float(data.get('deposit_amount')),
            cash_denomination_breakdown=cash_denom if cash_denom else {},
            cash_counter_machine_id=safe_str(data.get('cash_counter_machine_id', ''))
        )
        
        # Step 5: Fraud Detection Scoring (Section 5.5)
        fraud_result = Fraud_Detection_Scoring_API(
            transaction_id=transaction_id,
            customer_id=safe_str(data.get('customer_id')),
            account_number=safe_str(data.get('account_number')),
            deposit_amount=safe_float(data.get('deposit_amount')),
            deposit_channel=safe_str(data.get('deposit_channel')),
            deposit_type=safe_str(data.get('deposit_type')),
            branch_code=safe_str(data.get('branch_code')),
            transaction_timestamp=safe_str(data.get('transaction_timestamp'))
        )
        
        # Step 6: Supervisor Approval Routing (Section 5.6)
        supervisor_result = Supervisor_Approval_Routing_API(
            transaction_id=transaction_id,
            deposit_amount=safe_float(data.get('deposit_amount')),
            teller_id=safe_str(data.get('teller_id', '')),
            kyc_verification_status=safe_str(data.get('kyc_verification_status', 'VERIFIED')),
            aml_screening_result=safe_str(data.get('aml_screening_result', 'CLEAR')),
            aml_risk_score=safe_int(data.get('aml_risk_score', 0)),
            fraud_detection_score=safe_float(fraud_result.get('fraud_detection_score', 0.0)),
            counterfeit_detection_result=safe_str(data.get('counterfeit_detection_result', 'NOT_APPLICABLE')),
            ctr_filing_required=safe_bool(ctr_result.get('ctr_filing_required', False)),
            transaction_notes=safe_str(data.get('transaction_notes', ''))
        )
        
        # Step 7: Term Deposit Processing (Section 5.7) - only for TERM_DEPOSIT
        term_deposit_result = None
        if safe_str(data.get('deposit_type')) == 'TERM_DEPOSIT':
            term_deposit_result = Term_Deposit_Processing_API(
                transaction_id=transaction_id,
                deposit_type=safe_str(data.get('deposit_type')),
                deposit_amount=safe_float(data.get('deposit_amount')),
                term_length_months=safe_int(data.get('term_length_months', 0)),
                transaction_timestamp=safe_str(data.get('transaction_timestamp')),
                interest_rate_apy=safe_float(data.get('interest_rate_apy', 0.0)),
                early_withdrawal_penalty_rate=safe_float(data.get('early_withdrawal_penalty_rate', 0.0))
            )
        
        # Step 8: Compliance Aggregation (Section 5.9)
        compliance_result = Compliance_Aggregation_API(
            transaction_id=transaction_id,
            kyc_verification_status=safe_str(data.get('kyc_verification_status', 'VERIFIED')),
            aml_screening_result=safe_str(data.get('aml_screening_result', 'CLEAR')),
            aml_risk_score=safe_int(data.get('aml_risk_score', 0)),
            counterfeit_detection_result=safe_str(data.get('counterfeit_detection_result', 'NOT_APPLICABLE')),
            fraud_detection_score=safe_float(fraud_result.get('fraud_detection_score', 0.0)),
            supervisor_approval_required=safe_bool(data.get('supervisor_approval_required', False)),
            supervisor_id=safe_str(data.get('supervisor_id', '')),
            supervisor_approval_timestamp=safe_str(data.get('supervisor_approval_timestamp', '')),
            ctr_filing_required=safe_bool(ctr_result.get('ctr_filing_required', False))
        )
        
        # Step 9: Account Ledger Posting (Section 5.8) - only if compliance passed
        ledger_result = None
        if compliance_result.get('compliance_check_passed', False):
            ledger_result = Account_Ledger_Posting_API(
                transaction_id=transaction_id,
                account_number=safe_str(data.get('account_number')),
                deposit_amount=safe_float(data.get('deposit_amount')),
                previous_account_balance=safe_float(data.get('previous_account_balance', 0.0)),
                funding_source_type=safe_str(data.get('funding_source_type')),
                funding_source_account=safe_str(data.get('funding_source_account', '')),
                branch_code=safe_str(data.get('branch_code')),
                account_type=safe_str(data.get('account_type')),
                transaction_timestamp=safe_str(data.get('transaction_timestamp')),
                compliance_check_passed=compliance_result.get('compliance_check_passed', False),
                transaction_approved=compliance_result.get('transaction_approved', False),
                cd_certificate_number=safe_str(term_deposit_result.get('cd_certificate_number', '') if term_deposit_result else ''),
                debit_card_issued=safe_bool(data.get('debit_card_issued', False)),
                online_banking_enabled=safe_bool(data.get('online_banking_enabled', False)),
                mobile_app_enabled=safe_bool(data.get('mobile_app_enabled', False)),
                checkbook_ordered=safe_bool(data.get('checkbook_ordered', False))
            )
        
        # Step 10: Receipt Generation (Section 5.10) - only if transaction approved
        receipt_result = None
        if compliance_result.get('transaction_approved', False) and ledger_result:
            receipt_result = Receipt_Generation_API(
                transaction_id=transaction_id,
                customer_name=safe_str(data.get('customer_name')),
                account_number=safe_str(data.get('account_number')),
                deposit_amount=safe_float(data.get('deposit_amount')),
                new_account_balance=safe_float(ledger_result.get('new_account_balance', 0.0)),
                transaction_reference_id=safe_str(ledger_result.get('transaction_reference_id', '')),
                transaction_timestamp=safe_str(data.get('transaction_timestamp')),
                branch_code=safe_str(data.get('branch_code')),
                receipt_delivery_method=safe_str(data.get('receipt_delivery_method')),
                customer_email=safe_str(data.get('customer_email')),
                customer_phone=safe_str(data.get('customer_phone')),
                cd_certificate_number=safe_str(term_deposit_result.get('cd_certificate_number', '') if term_deposit_result else ''),
                maturity_date=safe_str(term_deposit_result.get('maturity_date', '') if term_deposit_result else ''),
                interest_rate_apy=safe_float(data.get('interest_rate_apy', 0.0)),
                calculated_interest_at_maturity=safe_float(term_deposit_result.get('calculated_interest_at_maturity', 0.0) if term_deposit_result else 0.0),
                transaction_notes=safe_str(data.get('transaction_notes', '')),
                transaction_approved=compliance_result.get('transaction_approved', False),
                minimum_balance_requirement=safe_float(data.get('minimum_balance_requirement', 0.0)),
                monthly_maintenance_fee=safe_float(data.get('monthly_maintenance_fee', 0.0)),
                early_withdrawal_penalty_rate=safe_float(data.get('early_withdrawal_penalty_rate', 0.0)),
                final_transaction_fee=0.0
            )
        
        # Step 11: Audit Trail Recording (Section 5.11)
        audit_result = Audit_Trail_Recording_API(
            transaction_id=transaction_id,
            customer_id=safe_str(data.get('customer_id')),
            account_number=safe_str(data.get('account_number')),
            transaction_timestamp=safe_str(data.get('transaction_timestamp')),
            deposit_type=safe_str(data.get('deposit_type')),
            deposit_amount=safe_float(data.get('deposit_amount')),
            teller_id=safe_str(data.get('teller_id', '')),
            branch_code=safe_str(data.get('branch_code')),
            kyc_verification_status=safe_str(data.get('kyc_verification_status', 'VERIFIED')),
            kyc_verification_timestamp=safe_str(data.get('kyc_verification_timestamp', '')),
            aml_screening_result=safe_str(data.get('aml_screening_result', 'CLEAR')),
            aml_risk_score=safe_int(data.get('aml_risk_score', 0)),
            sanctions_screening_timestamp=safe_str(data.get('sanctions_screening_timestamp', '')),
            fraud_detection_score=safe_float(fraud_result.get('fraud_detection_score', 0.0)),
            counterfeit_detection_result=safe_str(data.get('counterfeit_detection_result', 'NOT_APPLICABLE')),
            supervisor_approval_required=safe_bool(data.get('supervisor_approval_required', False)),
            supervisor_id=safe_str(data.get('supervisor_id', '')),
            supervisor_approval_timestamp=safe_str(data.get('supervisor_approval_timestamp', '')),
            compliance_check_passed=compliance_result.get('compliance_check_passed', False),
            transaction_approved=compliance_result.get('transaction_approved', False),
            approval_rejection_reason=safe_str(compliance_result.get('approval_rejection_reason', '')),
            new_account_balance=safe_float(ledger_result.get('new_account_balance', 0.0) if ledger_result else 0.0),
            transaction_reference_id=safe_str(ledger_result.get('transaction_reference_id', '') if ledger_result else ''),
            account_status=safe_str(ledger_result.get('account_status', '') if ledger_result else ''),
            processing_time_seconds=safe_int(ledger_result.get('processing_time_seconds', 0) if ledger_result else 0),
            receipt_number=safe_str(receipt_result.get('receipt_number', '') if receipt_result else ''),
            previous_account_balance=safe_float(data.get('previous_account_balance', 0.0)),
            ctr_filing_required=safe_bool(ctr_result.get('ctr_filing_required', False)),
            cash_drawer_total_after_transaction=safe_float(currency_result.get('cash_drawer_total_after_transaction', 0.0))
        )
        
        # Output final results
        print(f"\ntransaction_id:{transaction_id}")
        print(f"transaction_approved:{compliance_result.get('transaction_approved', False)}")
        print(f"approval_rejection_reason:{safe_str(compliance_result.get('approval_rejection_reason', ''))}")
        print(f"new_account_balance:{safe_float(ledger_result.get('new_account_balance', 0.0) if ledger_result else 0.0)}")
        print(f"transaction_reference_id:{safe_str(ledger_result.get('transaction_reference_id', '') if ledger_result else '')}")
        print(f"cd_certificate_number:{safe_str(term_deposit_result.get('cd_certificate_number', '') if term_deposit_result else '')}")
        print(f"calculated_interest_at_maturity:{safe_float(term_deposit_result.get('calculated_interest_at_maturity', 0.0) if term_deposit_result else 0.0)}")
        print(f"account_status:{safe_str(ledger_result.get('account_status', '') if ledger_result else '')}")
        print(f"processing_time_seconds:{safe_int(ledger_result.get('processing_time_seconds', 0) if ledger_result else 0)}")
        print(f"cash_drawer_total_after_transaction:{safe_float(currency_result.get('cash_drawer_total_after_transaction', 0.0))}")
        print(f"fraud_detection_score:{safe_float(fraud_result.get('fraud_detection_score', 0.0))}")
        print(f"compliance_check_passed:{compliance_result.get('compliance_check_passed', False)}")
        print(f"denomination_reconciliation_status:{safe_str(currency_result.get('denomination_reconciliation_status', 'NOT_APPLICABLE'))}")
        print(f"final_transaction_fee:0.0")
        print(f"receipt_number:{safe_str(receipt_result.get('receipt_number', '') if receipt_result else '')}")
        
    except Exception as e:
        print(f"\nError processing {transaction_id}: {str(e)}")
        continue
